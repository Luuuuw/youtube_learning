# dependencies
node_modules/
.pnp
.pnp.js

# next.js build output
.next/
out/

# production build
build/

# environment variables (contains secrets)
.env*.local
.env

# runtime data (user data, sessions, etc.)
data/*
# 以下内容数据随代码打包，需纳入 git（运行时数据仍被上面的 data/* 忽略）
!data/flashcards.json
!data/local-dict.json
!data/vocab-system.json
!data/word-lists/

# large binary files
bin/

# runtime progress files
process-progress.json
download-progress.json

# video files (too large for git, deploy separately)
public/content/**/*.mp4
public/content/**/*.webm
public/content/**/*.mkv
# yt-dlp temporary fragments (e.g. video.f399.mp4.part)
public/content/**/*.part
public/content/**/*.ytdl
public/content/**/*.tmp
# 补漏脚本 / 翻译流程产生的临时文件
public/content/**/*.bak-*
public/content/**/*.old
public/content/**/.translate-state.json
# yt-dlp 产生的 webp 缩略图残留（正版是 thumbnail.jpg）
public/content/**/*.webp

# Safe-Mutation Framework 运行时产物
# snapshot 备份（每次 AI 写盘前自动 .copyFileSync 出来的备份，轮换保留 5 份）
public/content/**/*.snapshot-*.bak
data/**/*.snapshot-*.bak
# Pending 提案（HITL 等审批的 staging）
data/ai-pending/
# Audit log（结构化记录所有 AI 改动 + revert）
data/ai-audit-log*.json
# proxy config (contains local proxy address, do not commit)
proxy_config.json

# python cache
__pycache__/
*.pyc

# IDE
.trae/
.vscode/
.idea/
*.swp
*.swo

# OS files
Thumbs.db
.DS_Store
desktop.ini

# logs
logs/

# 本地拉取的 Render 用户数据备份
backups/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript cache
*.tsbuildinfo
next-env.d.ts
